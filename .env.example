# Examples only. Configure hosted runtime values with Sites.
OPENAI_API_KEY=
OPENAI_PASSPORT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional VECTOR AI model overrides; the existing OPENAI_API_KEY is reused.
OPENAI_ASSISTANT_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Telegram: store as a Sites secret. Target channel is pinned in src/telegram.js.
TELEGRAM_BOT_TOKEN=
